# ════════════════════════════════════════════════════════════
# En-têtes HTTP servis par Cloudflare Pages
# ════════════════════════════════════════════════════════════
# Sans ce fichier, Cloudflare applique « max-age=0, must-revalidate »
# à TOUT — y compris aux bundles JS dont le nom porte déjà une
# empreinte de contenu (admin-CocKS2dj.js). Résultat : 6 allers-retours
# de revalidation à chaque ouverture de la console, pour des fichiers
# qui ne changent jamais. Audit du 20/07/2026.

# ── Ressources empreintées : cachables à vie ──
# Le nom change à chaque build, donc aucun risque de servir du périmé.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

# ── Pages HTML : jamais mises en cache durablement ──
# Elles référencent les bundles empreintés ; une page périmée
# pointerait vers des fichiers disparus.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ── Sécurité, sur tout le site ──
/*
  # Interdit l'intégration du site dans une iframe TIERCE (protection
  # contre le détournement de clic). SAMEORIGIN et non DENY : le
  # concepteur de galerie affiche la vraie galerie en aperçu, et un
  # cadre de MÊME ORIGINE n'est pas un vecteur de détournement — il
  # faudrait déjà contrôler une page de notre domaine, auquel cas le
  # cadre serait le moindre des soucis. Tout site externe reste refusé.
  X-Frame-Options: SAMEORIGIN
  # Empêche un navigateur de « deviner » le type d'un fichier.
  X-Content-Type-Options: nosniff
  # Ne divulgue pas l'adresse d'origine vers les sites externes.
  Referrer-Policy: strict-origin-when-cross-origin
  # Aucune de ces API n'est utilisée par le produit.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  # Force HTTPS pendant un an (les domaines .app l'imposent déjà,
  # cette ligne couvre laloge.house et timelesshouse.org).
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # CSP volontairement MINIMALE : le site charge des scripts CDN (unpkg,
  # cdn.tailwindcss) et du JS inline, donc verrouiller script-src casserait
  # la prod. On pose seulement les directives sans risque, qui n'affectent
  # ni les scripts ni les styles ni les connexions :
  #   · object-src 'none'     → aucun plugin/embed Flash/PDF exploitable
  #   · base-uri 'self'       → empêche le détournement des URLs relatives
  #   · frame-ancestors 'self'→ embarquement réservé à NOS pages
  # (un verrouillage complet de script-src demanderait de retirer les CDN
  #  et les scripts inline — chantier séparé.)
  #
  # ⚠️ POURQUOI 'self' ET NON 'none' (25/07/2026) : le concepteur de
  # galerie affiche la vraie galerie en aperçu dans une iframe de même
  # origine. Avec 'none', le navigateur la bloquait SANS aucune erreur
  # visible — écran noir, console vide.
  # Une exception par chemin a d'abord été tentée : elle NE MARCHE PAS.
  # Cloudflare n'écrase pas la règle /*, il ajoute un second en-tête, et
  # le navigateur applique alors l'INTERSECTION — 'none' l'emportait
  # toujours (constaté en production). Lister à la place les ~25 chemins
  # à protéger aurait été pire : une page créée demain perdrait sa
  # protection en silence.
  # 'self' garde donc la protection là où elle compte — aucun site
  # externe ne peut nous encadrer, et c'est de là que vient le
  # détournement de clic.
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'
